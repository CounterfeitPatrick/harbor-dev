{
  "name": "harbor-docs",
  "private": true,
  "version": "0.0.0",
  "description": "Documentation site for HARBOR",
  "license": "Apache-2.0",
  "scripts": {
    "docs:dev": "npm run docs:gallery && vitepress dev docs",
    "docs:gallery": "mkdir -p docs/public/gallery && cp assets/gallery/*.webp docs/public/gallery/",
    "docs:build": "npm run docs:gallery && python3 tools/gen_docs_reference.py && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:check": "python3 tools/gen_docs_reference.py --check"
  },
  "devDependencies": {
    "markdown-it-mathjax3": "^4.3.2",
    "vitepress": "^1.6.3"
  }
}
